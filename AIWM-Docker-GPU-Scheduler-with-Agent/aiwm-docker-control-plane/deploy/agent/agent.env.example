# Set enrollment token to match your Control Plane; no default secret.
AIWM_CONTROL_PLANE_URL=https://control-plane.example
AIWM_ENROLLMENT_TOKEN=
# Leave empty to use stable /etc/machine-id, then hostname.
AIWM_AGENT_MACHINE_ID=
AIWM_AGENT_NAME=docker-gpu-server-01
AIWM_AGENT_LABELS=site=hanoi,pool=docker
AIWM_AGENT_STATE_FILE=/var/lib/aiwm-agent/state.json
AIWM_DOCKER_ENDPOINT=unix:///var/run/docker.sock
AIWM_AGENT_HEARTBEAT_INTERVAL=5s
AIWM_AGENT_INVENTORY_INTERVAL=15s
AIWM_AGENT_COMMAND_POLL_INTERVAL=2s
AIWM_AGENT_REQUEST_TIMEOUT=30s
AIWM_UNKNOWN_MEMORY_MIB=256
AIWM_UNKNOWN_UTILIZATION_PCT=5
AIWM_AGENT_TLS_CA_FILE=
AIWM_AGENT_TLS_CERT_FILE=
AIWM_AGENT_TLS_KEY_FILE=
AIWM_LOG_LEVEL=info
