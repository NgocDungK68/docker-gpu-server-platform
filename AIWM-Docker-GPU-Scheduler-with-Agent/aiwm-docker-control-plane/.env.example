# Chạy scripts/configure.py tại workspace root, sau đó xem docs/TESTING_RUNBOOK.md.
AIWM_DATABASE_URL=
AIWM_BOOTSTRAP_ORGANIZATION_CODE=
AIWM_BOOTSTRAP_ORGANIZATION_NAME=
AIWM_BOOTSTRAP_USERNAME=
AIWM_BOOTSTRAP_PASSWORD=
AIWM_HTTP_ADDR=127.0.0.1:8080
AIWM_STATE_FILE=.local/control-plane.gob
AIWM_AGENT_HEARTBEAT_INTERVAL=5s
AIWM_AGENT_OFFLINE_AFTER=20s
AIWM_COMMAND_LEASE=15s
AIWM_SCHEDULER_INTERVAL=2s
AIWM_RECONCILE_INTERVAL=5s
AIWM_SCHEDULER_STRATEGY=best-fit
AIWM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AIWM_TLS_CERT_FILE=
AIWM_TLS_KEY_FILE=
AIWM_LOG_LEVEL=info

# Training output (tùy chọn). URL phải truy cập được từ training container.
# Để trống endpoint = chưa bật checkpoint/artifact contract.
AIWM_S3_ENDPOINT=
AIWM_S3_PUBLIC_ENDPOINT=
AIWM_S3_REGION=us-east-1
AIWM_S3_BUCKET=aiwm-artifacts
AIWM_S3_ACCESS_KEY=
AIWM_S3_SECRET_KEY=
AIWM_S3_CREATE_BUCKET=false
AIWM_TRAINING_API_URL=
AIWM_CHECKPOINT_WARNING_FRACTION=0.1
AIWM_CHECKPOINT_WARNING_MIN=5m
AIWM_CHECKPOINT_WARNING_MAX=30m
AIWM_TRAINING_UPLOAD_TIMEOUT=15m
AIWM_TRAINING_MAX_UPLOAD_BYTES=5368709120
